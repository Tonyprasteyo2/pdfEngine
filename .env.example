APP_NAME=simrs-pdf-service
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0
API_KEY=CHANGE_THIS_TO_A_STRONG_SECRET_KEY
PDF_MAX_UPLOAD_MB=50
PDF_MAX_FILES=30
PDF_MAX_PAGES=500
PDF_REQUEST_TIMEOUT=120
PDF_STORAGE_ROOT=storage
PDF_TEMP_DIR=storage/working
PDF_OUTPUT_DIR=storage/output
PDF_INPUT_DIR=storage/input
PDF_LOG_DIR=storage/logs
PDF_ENGINE_PRIMARY=pypdf
PDF_ENGINE_FALLBACK=pymupdf,ghostscript,qpdf
PDF_CLEANUP_ENABLED=true
PDF_RETENTION_MINUTES=60
LOG_LEVEL=INFO
